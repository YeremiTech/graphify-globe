{
  "name": "graphify-globe-react-responsive",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "bench:generate": "node benchmarks/generate-graph.mjs",
    "bench:suite": "node benchmarks/run-suite.mjs",
    "bench:suite:gc": "node --expose-gc benchmarks/run-suite.mjs",
    "bench:suite:full": "node --expose-gc benchmarks/run-suite.mjs --full --write-files",
    "bench:browser": "vite --open /benchmarks/browser/index.html"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "vite": "8.1.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
